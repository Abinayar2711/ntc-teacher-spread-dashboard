# Copy to .streamlit/secrets.toml (gitignored) to run locally, and paste the
# same block into Streamlit Cloud -> Settings -> Secrets for the live app.
# The [auth] header must sit at column 1, and every bare key must go ABOVE it.
#
# Same OAuth client as the other report apps -- do not create a new one. Only
# redirect_uri and cookie_secret differ per app.
[auth]
redirect_uri = "https://ntc-teacher-spread-dashboard.streamlit.app/oauth2callback"
cookie_secret = "<unique per app: openssl rand -hex 32>"
client_id = "<shared OAuth client id>"
client_secret = "<shared OAuth client secret>"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
